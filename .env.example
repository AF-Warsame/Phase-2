# Python module search path for local execution
PYTHONPATH=src

# Logging defaults for CLI + future services
LOG_LEVEL=1
LOG_FILE=catalog.log

# External API tokens (optional but recommended)
GITHUB_TOKEN=
HUGGINGFACE_HUB_TOKEN=
PURDUE_GENAI_API_KEY=

# AWS + LocalStack configuration
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_AUTH_TOKEN=
REGISTRY_ARTIFACT_BUCKET=model-registry-artifacts
REGISTRY_METADATA_TABLE=ModelRegistryMetadata
MODEL_REGISTRY_BASE_URL=http://localhost:8000
